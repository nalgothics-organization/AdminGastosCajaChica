# Variables de entorno de ejemplo para el sistema
# COPIAR A .env Y AJUSTAR VALORES (NUNCA SUBIR .env AL REPOSITORIO)
APP_ENV=development
API_PORT=8000
DATABASE_URL=sqlite:///./caja_chica.db
SECRET_KEY=change_this_to_a_secure_secret_in_local_env
# Comprobantes (RF07/HU16): carpeta local de imágenes y tamaño máximo por foto
UPLOADS_DIR=./uploads
MAX_IMAGEN_MB=10
