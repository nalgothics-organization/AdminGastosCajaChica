# Variables de entorno de ejemplo para el sistema
# COPIAR A .env Y AJUSTAR VALORES (NUNCA SUBIR .env AL REPOSITORIO)
APP_ENV=development
API_PORT=8000
SECRET_KEY=change_this_to_a_secure_secret_in_local_env

# Base de datos PostgreSQL (la levanta `docker compose up -d`)
POSTGRES_USER=cajachica
POSTGRES_PASSWORD=change_this_to_a_local_password
POSTGRES_DB=cajachica
POSTGRES_PORT=5432
# Debe coincidir con los valores de arriba. Para usar un archivo local en vez de PostgreSQL:
# DATABASE_URL=sqlite:///./caja_chica.db
DATABASE_URL=postgresql+psycopg://cajachica:change_this_to_a_local_password@localhost:5432/cajachica

# Comprobantes (RF07/HU16): carpeta local de imágenes y tamaño máximo por foto
UPLOADS_DIR=./uploads
MAX_IMAGEN_MB=10
# Lee la foto con OCR y rechaza las borrosas, oscuras o sin ningún monto (RNF05/HU21)
VALIDAR_LEGIBILIDAD=true

# Bloqueo por comprobaciones vencidas (RF04/HU04): días para comprobar un fondo aprobado
# antes de que no se le autorice al residente un fondo nuevo
LIMITE_DIAS_COMPROBACION=7
